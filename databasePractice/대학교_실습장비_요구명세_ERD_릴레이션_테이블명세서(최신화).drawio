        <mxCell id="spec-15" parent="spec-4" style="rounded=0;html=0;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AABB2;strokeWidth=1;fontColor=#20303A;fontFamily=Consolas;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" value="VARCHAR(20)" vertex="1">
