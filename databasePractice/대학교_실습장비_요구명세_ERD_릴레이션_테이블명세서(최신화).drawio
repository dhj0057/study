        <mxCell id="spec-10" parent="spec-4" style="rounded=0;html=0;whiteSpace=wrap;fillColor=#EEEEEE;strokeColor=#9AABB2;strokeWidth=1;fontColor=#20303A;fontFamily=Malgun Gothic;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" value="기본값" vertex="1">
