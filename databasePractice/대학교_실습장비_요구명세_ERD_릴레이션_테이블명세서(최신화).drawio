        <mxCell id="derived-title" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Malgun Gothic;fontSize=22;fontColor=#222222;fillColor=#EEEEEE;strokeColor=#666666;strokeWidth=1;align=center;verticalAlign=middle;spacing=12;fontStyle=1;" value="대여 조회와 제3정규형" vertex="1">
          <mxGeometry height="55" width="580" x="40" y="950" as="geometry" />
        </mxCell>
        <mxCell id="derived" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Malgun Gothic;fontSize=19;fontColor=#222222;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=1;align=left;verticalAlign=middle;spacing=12;fontStyle=0;" value="대여기록은 예약번호를 통해 학생과 장비를 조회한다.&#10;반납예정일시 due_at은 뷰에서 ends_at으로 제공한다.&#10;장비분류명은 equipment_category에 저장한다." vertex="1">
          <mxGeometry height="150" width="580" x="40" y="1005" as="geometry" />
        </mxCell>
        <mxCell id="row-checks-title" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Malgun Gothic;fontSize=22;fontColor=#222222;fillColor=#EEEEEE;strokeColor=#666666;strokeWidth=1;align=center;verticalAlign=middle;spacing=12;fontStyle=1;" value="행 단위 제약" vertex="1">
          <mxGeometry height="55" width="1150" x="40" y="1360" as="geometry" />
        </mxCell>
        <mxCell id="row-checks" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Malgun Gothic;fontSize=19;fontColor=#222222;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=1;align=left;verticalAlign=middle;spacing=12;fontStyle=0;" value="예약시작일시 &lt; 예약종료일시&#10;반납일시는 대여일시 이상, 정비완료일시는 정비시작일시 이상&#10;정비완료일시와 처리내용은 둘 다 NULL이거나 둘 다 값이 있어야 한다." vertex="1">
          <mxGeometry height="122" width="1150" x="40" y="1415" as="geometry" />
        </mxCell>
        <mxCell id="tx-checks-title" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Malgun Gothic;fontSize=22;fontColor=#222222;fillColor=#EEEEEE;strokeColor=#666666;strokeWidth=1;align=center;verticalAlign=middle;spacing=12;fontStyle=1;" value="여러 행을 확인하는 트랜잭션 제약" vertex="1">
          <mxGeometry height="55" width="1150" x="1360" y="1360" as="geometry" />
        </mxCell>
        <mxCell id="tx-checks" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Malgun Gothic;fontSize=19;fontColor=#222222;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=1;align=left;verticalAlign=middle;spacing=12;fontStyle=0;" value="승인 충돌은 같은 장비의 APPROVED 예약에 한해 검사한다.&#10;중복 조건  |  기존 시작 &lt; 새 종료 AND 기존 종료 &gt; 새 시작&#10;장비 행을 잠가 동시 승인, 미반납 장비의 추가 대여, 진행 중 정비 중복을 막는다." vertex="1">
          <mxGeometry height="122" width="1150" x="1360" y="1415" as="geometry" />
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
  
  <diagram name="04 SQL 테이블 명세서" id="rTAcm4Ue3wpbF_7431RA">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1840" pageHeight="1620" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" parent="1" style="html=0;align=left;fontColor=#222222;spacingLeft=14;text;whiteSpace=wrap;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Malgun Gothic;fontSize=28;fontStyle=1;" value="04 SQL 테이블 명세서" vertex="1">
          <mxGeometry height="50" width="1770" x="35" y="20" as="geometry" />
        </mxCell>
        <mxCell id="3" parent="1" style="html=0;align=left;fontColor=#222222;spacingLeft=14;text;whiteSpace=wrap;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Malgun Gothic;fontSize=17;" value="MariaDB 10.11 / MySQL 8.4 · 01번의 16개 요구사항과 02·03번의 6개 개체 기준" vertex="1">
          <mxGeometry height="30" width="1770" x="35" y="76" as="geometry" />
        </mxCell>
        <mxCell id="4" parent="1" style="html=0;align=left;fontColor=#222222;spacingLeft=14;text;whiteSpace=wrap;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Malgun Gothic;fontSize=17;" value="빈 스키마를 선택한 뒤 ①~⑦ 순서로 실행한다. SQL 상자를 더블클릭하면 전체 문장을 복사할 수 있다. COMMENT는 컬럼의 한글 논리명이다." vertex="1">
          <mxGeometry height="30" width="1770" x="35" y="108" as="geometry" />
        </mxCell>
        <mxCell id="5" parent="1" style="html=0;align=left;fontColor=#222222;spacingLeft=14;rounded=0;whiteSpace=wrap;fillColor=#EEEEEE;strokeColor=#666666;fontFamily=Malgun Gothic;fontSize=19;fontStyle=1;verticalAlign=middle;" value="① 학생" vertex="1">
          <mxGeometry height="34" width="850" x="45" y="155" as="geometry" />
        </mxCell>
        <mxCell id="6" parent="1" style="html=0;align=left;fontColor=#222222;spacingLeft=14;rounded=0;whiteSpace=nowrap;fillColor=#FFFFFF;strokeColor=#666666;fontFamily=Consolas;fontSize=15;verticalAlign=top;spacingTop=10;overflow=visible;" value="CREATE TABLE student (&#10;    student_id   VARCHAR(20)  NOT NULL COMMENT '학번',&#10;    student_name VARCHAR(50)  NOT NULL COMMENT '이름',&#10;    department   VARCHAR(100) NOT NULL COMMENT '학과',&#10;    phone        VARCHAR(30)  NOT NULL COMMENT '연락처',&#10;    PRIMARY KEY (student_id)&#10;) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;" vertex="1">
          <mxGeometry height="166" width="850" x="45" y="189" as="geometry" />
        </mxCell>
        <mxCell id="7" parent="1" style="html=0;align=left;fontColor=#222222;spacingLeft=14;rounded=0;whiteSpace=wrap;fillColor=#EEEEEE;strokeColor=#666666;fontFamily=Malgun Gothic;fontSize=19;fontStyle=1;verticalAlign=middle;" value="② 장비분류" vertex="1">
          <mxGeometry height="34" width="850" x="935" y="155" as="geometry" />
        </mxCell>
        <mxCell id="8" parent="1" style="html=0;align=left;fontColor=#222222;spacingLeft=14;rounded=0;whiteSpace=nowrap;fillColor=#FFFFFF;strokeColor=#666666;fontFamily=Consolas;fontSize=15;verticalAlign=top;spacingTop=10;overflow=visible;" value="CREATE TABLE equipment_category (&#10;    category_id   INT          NOT NULL AUTO_INCREMENT COMMENT '분류번호',&#10;    category_name VARCHAR(100) NOT NULL COMMENT '분류명',&#10;    PRIMARY KEY (category_id),&#10;    UNIQUE KEY uq_equipment_category_name (category_name)&#10;) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;" vertex="1">
          <mxGeometry height="146" width="850" x="935" y="189" as="geometry" />
        </mxCell>
        <mxCell id="9" parent="1" style="html=0;align=left;fontColor=#222222;spacingLeft=14;rounded=0;whiteSpace=wrap;fillColor=#EEEEEE;strokeColor=#666666;fontFamily=Malgun Gothic;fontSize=19;fontStyle=1;verticalAlign=middle;" value="③ 실습장비" vertex="1">
          <mxGeometry height="34" width="850" x="45" y="379" as="geometry" />
        </mxCell>
        <mxCell id="10" parent="1" style="html=0;align=left;fontColor=#222222;spacingLeft=14;rounded=0;whiteSpace=nowrap;fillColor=#FFFFFF;strokeColor=#666666;fontFamily=Consolas;fontSize=15;verticalAlign=top;spacingTop=10;overflow=visible;" value="CREATE TABLE equipment (&#10;    equipment_id     INT          NOT NULL AUTO_INCREMENT COMMENT '장비번호',&#10;    category_id      INT          NOT NULL COMMENT '분류번호',&#10;    equipment_name   VARCHAR(100) NOT NULL COMMENT '장비명',&#10;    model_name       VARCHAR(100) NULL DEFAULT NULL COMMENT '모델명',&#10;    equipment_status VARCHAR(20)  NOT NULL DEFAULT 'AVAILABLE' COMMENT '장비상태',&#10;    PRIMARY KEY (equipment_id),&#10;    CONSTRAINT fk_equipment_category FOREIGN KEY (category_id)&#10;        REFERENCES equipment_category (category_id)&#10;        ON DELETE RESTRICT ON UPDATE RESTRICT,&#10;    CONSTRAINT ck_equipment_status&#10;        CHECK (equipment_status IN ('AVAILABLE', 'MAINTENANCE'))&#10;) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;" vertex="1">
          <mxGeometry height="286" width="850" x="45" y="413" as="geometry" />
        </mxCell>
        <mxCell id="11" parent="1" style="html=0;align=left;fontColor=#222222;spacingLeft=14;rounded=0;whiteSpace=wrap;fillColor=#EEEEEE;strokeColor=#666666;fontFamily=Malgun Gothic;fontSize=19;fontStyle=1;verticalAlign=middle;" value="④ 예약" vertex="1">
          <mxGeometry height="34" width="850" x="935" y="379" as="geometry" />
        </mxCell>
        <mxCell id="12" parent="1" style="html=0;align=left;fontColor=#222222;spacingLeft=14;rounded=0;whiteSpace=nowrap;fillColor=#FFFFFF;strokeColor=#666666;fontFamily=Consolas;fontSize=15;verticalAlign=top;spacingTop=10;overflow=visible;" value="CREATE TABLE reservation (&#10;    reservation_id     BIGINT      NOT NULL AUTO_INCREMENT COMMENT '예약번호',&#10;    student_id         VARCHAR(20) NOT NULL COMMENT '학번',&#10;    equipment_id       INT         NOT NULL COMMENT '장비번호',&#10;    starts_at          DATETIME(0) NOT NULL COMMENT '예약시작일시',&#10;    ends_at            DATETIME(0) NOT NULL COMMENT '예약종료일시',&#10;    reservation_status VARCHAR(20) NOT NULL DEFAULT 'PENDING' COMMENT '예약상태',&#10;    PRIMARY KEY (reservation_id),&#10;    KEY ix_reservation_student (student_id),&#10;    KEY ix_reservation_overlap (equipment_id, reservation_status, starts_at, ends_at),&#10;    CONSTRAINT fk_reservation_student FOREIGN KEY (student_id)&#10;        REFERENCES student (student_id)&#10;        ON DELETE RESTRICT ON UPDATE RESTRICT,&#10;    CONSTRAINT fk_reservation_equipment FOREIGN KEY (equipment_id)&#10;        REFERENCES equipment (equipment_id)&#10;        ON DELETE RESTRICT ON UPDATE RESTRICT,&#10;    CONSTRAINT ck_reservation_period CHECK (starts_at &lt; ends_at),&#10;    CONSTRAINT ck_reservation_status&#10;        CHECK (reservation_status IN ('PENDING', 'APPROVED', 'CANCELLED'))&#10;) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;" vertex="1">
          <mxGeometry height="426" width="850" x="935" y="413" as="geometry" />
        </mxCell>
        <mxCell id="13" parent="1" style="html=0;align=left;fontColor=#222222;spacingLeft=14;rounded=0;whiteSpace=wrap;fillColor=#EEEEEE;strokeColor=#666666;fontFamily=Malgun Gothic;fontSize=19;fontStyle=1;verticalAlign=middle;" value="⑤ 대여기록" vertex="1">
          <mxGeometry height="34" width="850" x="45" y="863" as="geometry" />
        </mxCell>
        <mxCell id="14" parent="1" style="html=0;align=left;fontColor=#222222;spacingLeft=14;rounded=0;whiteSpace=nowrap;fillColor=#FFFFFF;strokeColor=#666666;fontFamily=Consolas;fontSize=15;verticalAlign=top;spacingTop=10;overflow=visible;" value="CREATE TABLE equipment_loan (&#10;    loan_id        BIGINT      NOT NULL AUTO_INCREMENT COMMENT '대여번호',&#10;    reservation_id BIGINT      NOT NULL COMMENT '예약번호',&#10;    loaned_at      DATETIME(0) NOT NULL COMMENT '대여일시',&#10;    returned_at    DATETIME(0) NULL DEFAULT NULL COMMENT '실제반납일시',&#10;    PRIMARY KEY (loan_id),&#10;    UNIQUE KEY uq_equipment_loan_reservation (reservation_id),&#10;    CONSTRAINT fk_equipment_loan_reservation FOREIGN KEY (reservation_id)&#10;        REFERENCES reservation (reservation_id)&#10;        ON DELETE RESTRICT ON UPDATE RESTRICT,&#10;    CONSTRAINT ck_equipment_loan_return&#10;        CHECK (returned_at IS NULL OR returned_at &gt;= loaned_at)&#10;) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;" vertex="1">
          <mxGeometry height="286" width="850" x="45" y="897" as="geometry" />
        </mxCell>
        <mxCell id="15" parent="1" style="html=0;align=left;fontColor=#222222;spacingLeft=14;rounded=0;whiteSpace=wrap;fillColor=#EEEEEE;strokeColor=#666666;fontFamily=Malgun Gothic;fontSize=19;fontStyle=1;verticalAlign=middle;" value="⑥ 정비이력" vertex="1">
          <mxGeometry height="34" width="850" x="935" y="863" as="geometry" />
        </mxCell>
        <mxCell id="16" parent="1" style="html=0;align=left;fontColor=#222222;spacingLeft=14;rounded=0;whiteSpace=nowrap;fillColor=#FFFFFF;strokeColor=#666666;fontFamily=Consolas;fontSize=15;verticalAlign=top;spacingTop=10;overflow=visible;" value="CREATE TABLE maintenance (&#10;    maintenance_id BIGINT        NOT NULL AUTO_INCREMENT COMMENT '정비번호',&#10;    equipment_id   INT           NOT NULL COMMENT '장비번호',&#10;    started_at     DATETIME(0)   NOT NULL COMMENT '정비시작일시',&#10;    completed_at   DATETIME(0)   NULL DEFAULT NULL COMMENT '정비완료일시',&#10;    reason         VARCHAR(500)  NOT NULL COMMENT '정비사유',&#10;    action_taken   VARCHAR(1000) NULL DEFAULT NULL COMMENT '처리내용',&#10;    PRIMARY KEY (maintenance_id),&#10;    KEY ix_maintenance_equipment (equipment_id, completed_at),&#10;    CONSTRAINT fk_maintenance_equipment FOREIGN KEY (equipment_id)&#10;        REFERENCES equipment (equipment_id)&#10;        ON DELETE RESTRICT ON UPDATE RESTRICT,&#10;    CONSTRAINT ck_maintenance_time&#10;        CHECK (completed_at IS NULL OR completed_at &gt;= started_at),&#10;    CONSTRAINT ck_maintenance_completion&#10;        CHECK ((completed_at IS NULL) = (action_taken IS NULL))&#10;) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;" vertex="1">
          <mxGeometry height="366" width="850" x="935" y="897" as="geometry" />
        </mxCell>
        <mxCell id="17" parent="1" style="html=0;align=left;fontColor=#222222;spacingLeft=14;rounded=0;whiteSpace=wrap;fillColor=#EEEEEE;strokeColor=#666666;fontFamily=Malgun Gothic;fontSize=19;fontStyle=1;verticalAlign=middle;" value="⑦ 대여 조회와 반납예정일시" vertex="1">
          <mxGeometry height="34" width="850" x="45" y="1287" as="geometry" />
        </mxCell>
        <mxCell id="18" parent="1" style="html=0;align=left;fontColor=#222222;spacingLeft=14;rounded=0;whiteSpace=nowrap;fillColor=#FFFFFF;strokeColor=#666666;fontFamily=Consolas;fontSize=15;verticalAlign=top;spacingTop=10;overflow=visible;" value="CREATE VIEW v_equipment_loan AS&#10;SELECT l.loan_id, l.reservation_id, r.student_id, r.equipment_id,&#10;       l.loaned_at, r.ends_at AS due_at, l.returned_at&#10;FROM equipment_loan AS l&#10;JOIN reservation AS r ON r.reservation_id = l.reservation_id;" vertex="1">
          <mxGeometry height="126" width="850" x="45" y="1321" as="geometry" />
        </mxCell>
        <mxCell id="19" parent="1" style="html=0;align=left;fontColor=#222222;spacingLeft=14;rounded=0;whiteSpace=wrap;fillColor=#EEEEEE;strokeColor=#666666;fontFamily=Malgun Gothic;fontSize=19;fontStyle=1;verticalAlign=middle;" value="예약과 대여의 무결성" vertex="1">
          <mxGeometry height="34" width="850" x="935" y="1287" as="geometry" />
        </mxCell>
        <mxCell id="20" parent="1" style="html=0;align=left;fontColor=#222222;spacingLeft=14;text;whiteSpace=wrap;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Malgun Gothic;fontSize=17;" value="대여기록의 reservation_id는 NOT NULL · FK · UNIQUE로 예약당 대여 0~1건을 보장한다. due_at은 예약종료일시를 뷰에서 조회한다.&#10;동시 승인 시 트랜잭션에서 equipment PK 행을 SELECT … FOR UPDATE로 먼저 잠근다. 같은 장비의 APPROVED 예약 중 기존 시작 &lt; 새 종료, 기존 종료 &gt; 새 시작인 행이 없을 때 승인하고 커밋한다. 승인 쓰기 경로 전체에 같은 잠금 순서를 적용한다." vertex="1">
          <mxGeometry height="172" width="850" x="935" y="1321" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  
