<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" type="device" version="24.7.17">
  <diagram id="page1" name="01 요구명세서">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="1. 대학교 실습장비 예약·대여·정비 관리 시스템" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=0;fontFamily=Malgun Gothic;fontSize=26;fontColor=#222222;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1;align=left;verticalAlign=middle;spacing=12;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="30" width="1710" height="55" />
        </mxCell>
        <mxCell id="3" value="요구사항 18개 · 한 관리실 · 예약 1건당 실물 장비 1대 · 학생 / 장비 / 예약 / 대여 / 정비" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=0;fontFamily=Malgun Gothic;fontSize=18;fontColor=#222222;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1;align=left;verticalAlign=middle;spacing=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="88" width="1710" height="45" />
        </mxCell>
        <mxCell id="4" value="R01" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=0;fontFamily=Malgun Gothic;fontSize=18;fontColor=#222222;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1;align=center;verticalAlign=middle;spacing=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="155" width="75" height="125" />
        </mxCell>
        <mxCell id="5" value="학생에 대한 학번, 이름, 학과, 연락처, 이용가능여부 정보를 유지해야 한다." style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=0;fontFamily=Malgun Gothic;fontSize=18;fontColor=#222222;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1;align=left;verticalAlign=middle;spacing=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="120" y="155" width="765" height="125" />
        </mxCell>
        <mxCell id="6" value="R02" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=0;fontFamily=Malgun Gothic;fontSize=18;fontColor=#222222;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1;align=center;verticalAlign=middle;spacing=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="293" width="75" height="125" />
        </mxCell>
        <mxCell id="7" value="학생은 학번으로 식별한다. 이용가능여부는 가능 또는 제한 중 하나이다." style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=0;fontFamily=Malgun Gothic;fontSize=18;fontColor=#222222;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1;align=left;verticalAlign=middle;spacing=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="120" y="293" width="765" height="125" />
        </mxCell>
        <mxCell id="8" value="R03" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=0;fontFamily=Malgun Gothic;fontSize=18;fontColor=#222222;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1;align=center;verticalAlign=middle;spacing=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="431" width="75" height="125" />
        </mxCell>
        <mxCell id="9" value="장비에 대한 장비번호, 장비명, 모델명, 보관위치, 운영상태 정보를 유지해야 한다. 운영상태는 정상 또는 정비중 중 하나이다." style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=0;fontFamily=Malgun Gothic;fontSize=18;fontColor=#222222;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1;align=left;verticalAlign=middle;spacing=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="120" y="431" width="765" height="125" />
        </mxCell>
        <mxCell id="10" value="R04" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=0;fontFamily=Malgun Gothic;fontSize=18;fontColor=#222222;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1;align=center;verticalAlign=middle;spacing=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="569" width="75" height="125" />
        </mxCell>
        <mxCell id="11" value="장비는 개별 실물에 부여한 장비번호로 식별한다. 같은 모델의 장비도 서로 다른 장비번호를 갖는다." style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=0;fontFamily=Malgun Gothic;fontSize=18;fontColor=#222222;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1;align=left;verticalAlign=middle;spacing=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="120" y="569" width="765" height="125" />
        </mxCell>
        <mxCell id="12" value="R05" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=0;fontFamily=Malgun Gothic;fontSize=18;fontColor=#222222;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1;align=center;verticalAlign=middle;spacing=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="707" width="75" height="125" />
        </mxCell>
        <mxCell id="13" value="한 학생은 여러 예약을 할 수 있고, 한 장비는 서로 다른 시점에 여러 학생에게 예약될 수 있다. 예약 한 건은 반드시 학생 한 명과 장비 한 대에 속한다." style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=0;fontFamily=Malgun Gothic;fontSize=18;fontColor=#222222;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1;align=left;verticalAlign=middle;spacing=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="120" y="707" width="765" height="125" />
        </mxCell>
        <mxCell id="14" value="R06" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=0;fontFamily=Malgun Gothic;fontSize=18;fontColor=#222222;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1;align=center;verticalAlign=middle;spacing=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="845" width="75" height="125" />
        </mxCell>
        <mxCell id="15" value="예약에 대한 예약번호, 신청일시, 예약시작일시, 예약종료일시, 예약상태, 사용목적 정보를 유지해야 한다. 예약상태는 확정, 취소, 대여전환 중 하나이다." style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=0;fontFamily=Malgun Gothic;fontSize=18;fontColor=#222222;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1;align=left;verticalAlign=middle;spacing=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="120" y="845" width="765" height="125" />
        </mxCell>
        <mxCell id="16" value="R07" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=0;fontFamily=Malgun Gothic;fontSize=18;fontColor=#222222;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1;align=center;verticalAlign=middle;spacing=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="983" width="75" height="125" />
        </mxCell>
        <mxCell id="17" value="예약은 예약번호로 식별한다. 이용 가능한 학생만 정상 상태의 장비를 예약할 수 있고, 신청일시 ≤ 예약시작일시 &lt; 예약종료일시를 만족해야 한다." style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=0;fontFamily=Malgun Gothic;fontSize=18;fontColor=#222222;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1;align=left;verticalAlign=middle;spacing=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="120" y="983" width="765" height="125" />
        </mxCell>
        <mxCell id="18" value="R08" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=0;fontFamily=Malgun Gothic;fontSize=18;fontColor=#222222;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1;align=center;verticalAlign=middle;spacing=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="1121" width="75" height="125" />
        </mxCell>
        <mxCell id="19" value="같은 장비에 대해 확정 또는 대여전환 상태인 예약의 시간 구간은 겹칠 수 없다. 예약종료일시와 다음 예약시작일시가 같은 경우는 허용한다." style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=0;fontFamily=Malgun Gothic;fontSize=18;fontColor=#222222;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1;align=left;verticalAlign=middle;spacing=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="120" y="1121" width="765" height="125" />
        </mxCell>
        <mxCell id="20" value="R09" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=0;fontFamily=Malgun Gothic;fontSize=18;fontColor=#222222;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1;align=center;verticalAlign=middle;spacing=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="1259" width="75" height="125" />
        </mxCell>
        <mxCell id="21" value="확정 예약은 대여 전까지 취소할 수 있다. 취소 이력은 삭제하지 않으며 취소된 예약은 대여할 수 없다. 미사용 확정 예약은 다음 처리 전에 취소로 정리한다." style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=0;fontFamily=Malgun Gothic;fontSize=18;fontColor=#222222;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1;align=left;verticalAlign=middle;spacing=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="120" y="1259" width="765" height="125" />
        </mxCell>
        <mxCell id="22" value="R10" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=0;fontFamily=Malgun Gothic;fontSize=18;fontColor=#222222;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1;align=center;verticalAlign=middle;spacing=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="915" y="155" width="75" height="125" />
        </mxCell>
        <mxCell id="23" value="대여는 확정 예약을 근거로만 등록한다. 예약 한 건에는 대여가 없거나 한 건만 연결되며, 대여 한 건은 반드시 예약 한 건에 속한다." style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=0;fontFamily=Malgun Gothic;fontSize=18;fontColor=#222222;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1;align=left;verticalAlign=middle;spacing=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="990" y="155" width="765" height="125" />
        </mxCell>
        <mxCell id="24" value="R11" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=0;fontFamily=Malgun Gothic;fontSize=18;fontColor=#222222;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1;align=center;verticalAlign=middle;spacing=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="915" y="293" width="75" height="125" />
        </mxCell>
        <mxCell id="25" value="대여에 대한 대여번호, 실제대여일시, 실제반납일시, 반납점검내용 정보를 유지해야 한다. 대여는 대여번호로 식별하며, 실제반납일시와 반납점검내용은 미반납 중에는 비어 있다." style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=0;fontFamily=Malgun Gothic;fontSize=18;fontColor=#222222;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1;align=left;verticalAlign=middle;spacing=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="990" y="293" width="765" height="125" />
        </mxCell>
        <mxCell id="26" value="R12" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=0;fontFamily=Malgun Gothic;fontSize=18;fontColor=#222222;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1;align=center;verticalAlign=middle;spacing=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="915" y="431" width="75" height="125" />
        </mxCell>
        <mxCell id="27" value="대여 시 학생의 이용가능여부와 장비의 운영상태를 다시 확인한다. 예약시작일시 ≤ 실제대여일시 &lt; 예약종료일시여야 하며, 같은 장비에 미반납 대여가 있으면 새 대여를 등록할 수 없다." style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=0;fontFamily=Malgun Gothic;fontSize=18;fontColor=#222222;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1;align=left;verticalAlign=middle;spacing=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="990" y="431" width="765" height="125" />
        </mxCell>
        <mxCell id="28" value="R13" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=0;fontFamily=Malgun Gothic;fontSize=18;fontColor=#222222;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1;align=center;verticalAlign=middle;spacing=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="915" y="569" width="75" height="125" />
        </mxCell>
        <mxCell id="29" value="대여를 등록하면 해당 예약을 대여전환으로 변경한다. 반납기한은 예약종료일시이며 실제반납일시가 기한을 넘으면 연체로 조회한다. 반납 시 반납일시와 점검내용을 함께 기록하고 실제반납일시는 실제대여일시 이상이어야 한다." style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=0;fontFamily=Malgun Gothic;fontSize=18;fontColor=#222222;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1;align=left;verticalAlign=middle;spacing=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="990" y="569" width="765" height="125" />
        </mxCell>
        <mxCell id="30" value="R14" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=0;fontFamily=Malgun Gothic;fontSize=18;fontColor=#222222;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1;align=center;verticalAlign=middle;spacing=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="915" y="707" width="75" height="125" />
        </mxCell>
        <mxCell id="31" value="장비 한 대에는 여러 정비 이력이 있을 수 있고, 정비 한 건은 반드시 장비 한 대에 속한다." style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=0;fontFamily=Malgun Gothic;fontSize=18;fontColor=#222222;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1;align=left;verticalAlign=middle;spacing=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="990" y="707" width="765" height="125" />
        </mxCell>
        <mxCell id="32" value="R15" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=0;fontFamily=Malgun Gothic;fontSize=18;fontColor=#222222;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1;align=center;verticalAlign=middle;spacing=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="915" y="845" width="75" height="125" />
        </mxCell>
        <mxCell id="33" value="정비에 대한 정비번호, 정비시작일시, 정비완료일시, 정비사유, 조치내용 정보를 유지해야 한다. 정비는 정비번호로 식별하며, 정비 진행 중에는 완료일시와 조치내용이 비어 있다." style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=0;fontFamily=Malgun Gothic;fontSize=18;fontColor=#222222;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1;align=left;verticalAlign=middle;spacing=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="990" y="845" width="765" height="125" />
        </mxCell>
        <mxCell id="34" value="R16" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=0;fontFamily=Malgun Gothic;fontSize=18;fontColor=#222222;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1;align=center;verticalAlign=middle;spacing=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="915" y="983" width="75" height="125" />
        </mxCell>
        <mxCell id="35" value="같은 장비에는 완료되지 않은 정비가 최대 한 건만 존재한다. 미반납 대여가 있으면 먼저 반납을 처리해야 정비를 시작할 수 있다. 정비 시작 시 해당 장비의 모든 확정 예약을 취소하고 운영상태를 정비중으로 변경한다." style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=0;fontFamily=Malgun Gothic;fontSize=18;fontColor=#222222;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1;align=left;verticalAlign=middle;spacing=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="990" y="983" width="765" height="125" />
        </mxCell>
        <mxCell id="36" value="R17" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=0;fontFamily=Malgun Gothic;fontSize=18;fontColor=#222222;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1;align=center;verticalAlign=middle;spacing=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="915" y="1121" width="75" height="125" />
        </mxCell>
        <mxCell id="37" value="정비 완료 시 완료일시와 조치내용을 함께 기록하고 운영상태를 정상으로 변경한다. 완료일시는 시작일시 이상이어야 하며 취소된 예약을 자동 복구하지 않는다." style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=0;fontFamily=Malgun Gothic;fontSize=18;fontColor=#222222;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1;align=left;verticalAlign=middle;spacing=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="990" y="1121" width="765" height="125" />
        </mxCell>
        <mxCell id="38" value="R18" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=0;fontFamily=Malgun Gothic;fontSize=18;fontColor=#222222;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1;align=center;verticalAlign=middle;spacing=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="915" y="1259" width="75" height="125" />
        </mxCell>
        <mxCell id="39" value="예약·대여·정비 이력에서 참조하는 학생과 장비 및 이력은 삭제하지 않는다. 학생·장비별 예약, 미반납·연체 대여, 장비별 정비 이력을 조회할 수 있어야 한다." style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=0;fontFamily=Malgun Gothic;fontSize=18;fontColor=#222222;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1;align=left;verticalAlign=middle;spacing=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="990" y="1259" width="765" height="125" />
        </mxCell>
        <mxCell id="40" value="범위 및 해석" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=0;fontFamily=Malgun Gothic;fontSize=18;fontColor=#222222;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1;align=center;verticalAlign=middle;spacing=12;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="1420" width="200" height="120" />
        </mxCell>
        <mxCell id="41" value="예약은 신청 즉시 확정한다. 예약 시간 변경·대여 연장·묶음 예약·결제·승인·로그인 구현은 제외한다.&#10;장비 운영상태는 정상/정비중만 저장하며, 대여중·미반납·연체 여부는 이력과 현재 시각으로 조회한다.&#10;미반납 연체 = 실제반납일시가 없고 현재 시각 &gt; 예약종료일시. 이력은 삭제하지 않는다." style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=0;fontFamily=Malgun Gothic;fontSize=18;fontColor=#222222;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1;align=left;verticalAlign=middle;spacing=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="245" y="1420" width="1510" height="120" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
