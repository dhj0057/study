        <mxCell id="42" value="관계 변환과 중복 방지" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=0;fontFamily=Malgun Gothic;fontSize=21;fontColor=#222222;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1;align=left;verticalAlign=middle;spacing=12;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="560" width="490" height="55" />
        </mxCell>
        <mxCell id="43" value="학생 1 : 예약 N&#10;장비 1 : 예약 N&#10;예약 1 : 대여 0..1&#10;장비 1 : 정비 N&#10;&#10;LOAN.reservation_id에 UNIQUE 적용&#10;대여의 학생·장비는 예약을 통해 조회&#10;반납기한은 예약종료일시에서 조회&#10;NULL 표시 외 모든 속성은 필수&#10;참조 데이터 삭제는 RESTRICT/NO ACTION" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=0;fontFamily=Malgun Gothic;fontSize=19;fontColor=#222222;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1;align=left;verticalAlign=middle;spacing=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="615" width="490" height="365" />
        </mxCell>
        <mxCell id="44" value="도메인 및 저장 기준" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=0;fontFamily=Malgun Gothic;fontSize=21;fontColor=#222222;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1;align=left;verticalAlign=middle;spacing=12;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1000" width="490" height="55" />
        </mxCell>
        <mxCell id="45" value="이용가능여부: 가능 / 제한&#10;운영상태: 정상 / 정비중&#10;예약상태: 확정 / 취소 / 대여전환&#10;일시: 한국 표준시 기준&#10;자료형은 DBMS 선정 후 실제 형식 확정" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=0;fontFamily=Malgun Gothic;fontSize=19;fontColor=#222222;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1;align=left;verticalAlign=middle;spacing=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1055" width="490" height="165" />
        </mxCell>
        <mxCell id="46" value="행 단위 제약" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=0;fontFamily=Malgun Gothic;fontSize=20;fontColor=#222222;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1;align=left;verticalAlign=middle;spacing=12;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1290" width="870" height="55" />
        </mxCell>
        <mxCell id="47" value="신청일시 ≤ 예약시작일시 &lt; 예약종료일시&#10;실제반납일시 ≥ 실제대여일시 / 정비완료일시 ≥ 정비시작일시&#10;반납일시·점검내용, 정비완료일시·조치내용은 각각 NULL 쌍 또는 값 쌍&#10;식별자는 변경하지 않으며 필수 문자열은 공백 입력을 허용하지 않는다." style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=0;fontFamily=Malgun Gothic;fontSize=19;fontColor=#222222;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1;align=left;verticalAlign=middle;spacing=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1345" width="870" height="170" />
        </mxCell>
        <mxCell id="48" value="여러 행을 확인하는 트랜잭션 제약" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=0;fontFamily=Malgun Gothic;fontSize=20;fontColor=#222222;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1;align=left;verticalAlign=middle;spacing=12;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="950" y="1290" width="900" height="55" />
        </mxCell>
        <mxCell id="49" value="예약 중복: 기존 시작 &lt; 새 종료 AND 새 시작 &lt; 기존 종료 (취소 제외)&#10;대여 등록 + 예약 대여전환을 함께 처리한다.&#10;정비 시작 + 확정 예약 취소 + 장비 정비중을 함께 처리한다.&#10;장비별 잠금으로 미반납 대여·진행 정비·동시 예약의 중복을 방지한다." style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=0;fontFamily=Malgun Gothic;fontSize=19;fontColor=#222222;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1;align=left;verticalAlign=middle;spacing=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="950" y="1345" width="900" height="170" />
        </mxCell>
